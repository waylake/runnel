{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waylake.github.io/runnel/schemas/benchmark-result-v1.json",
  "title": "Runnel benchmark result",
  "type": "object",
  "required": [
    "schema_version",
    "created_at_utc",
    "provenance",
    "engine",
    "protocol",
    "trials",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "created_at_utc": { "type": "string", "format": "date-time" },
    "provenance": {
      "type": "object",
      "required": [
        "repository_commit",
        "environment_capture_sha256",
        "checkpoint_manifest_sha256"
      ],
      "properties": {
        "repository_commit": { "type": ["string", "null"] },
        "repository_dirty": { "type": ["boolean", "null"] },
        "environment_capture_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "checkpoint_manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "checkpoint_revision": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "engine": {
      "type": "object",
      "required": ["name", "runtime_version", "adapter"],
      "properties": {
        "name": { "type": "string" },
        "runtime_version": { "type": "string" },
        "adapter": { "type": "string" }
      },
      "additionalProperties": true
    },
    "protocol": {
      "type": "object",
      "required": [
        "semantic_mode",
        "batch_size",
        "sampling",
        "prompt_tokens",
        "prompt_sha256",
        "max_output_tokens",
        "warmups",
        "trials_requested",
        "cache_state"
      ],
      "properties": {
        "semantic_mode": { "enum": ["exact", "approximate", "baseline"] },
        "batch_size": { "const": 1 },
        "prompt_tokens": { "type": "integer", "minimum": 1 },
        "prompt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "max_output_tokens": { "type": "integer", "minimum": 1 },
        "warmups": { "type": "integer", "minimum": 0 },
        "trials_requested": { "type": "integer", "minimum": 1 },
        "cache_state": { "type": "string" }
      },
      "additionalProperties": true
    },
    "trials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["phase", "index", "status"],
        "properties": {
          "phase": { "enum": ["warmup", "trial"] },
          "index": { "type": "integer", "minimum": 0 },
          "status": { "enum": ["ok", "error"] }
        },
        "additionalProperties": true
      }
    },
    "summary": {
      "type": "object",
      "required": ["successful_trials"],
      "properties": {
        "successful_trials": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
